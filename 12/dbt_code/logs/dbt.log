        when coalesce(workplace_city, 'stad ej specificerad') is null
        then null
        else upper(substr(coalesce(workplace_city, 'stad ej specificerad'), 1, 1)) || lower(substr(coalesce(workplace_city, 'stad ej specificerad'), 2))
    end
 AS workplace_city

 from src_employer
    )

